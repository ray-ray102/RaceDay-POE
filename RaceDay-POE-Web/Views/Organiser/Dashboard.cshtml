@model List<RaceDay_POE_Web.Models.Api.OrganiserEventDto>
@{
    ViewData["Title"] = "Organiser Dashboard";
    var upcoming = Model.Count(e => e.IsUpcoming);
    var entries = Model.Sum(e => e.EnrolmentCount);
    var next = Model.Where(e => e.IsUpcoming).OrderBy(e => e.EventDate).FirstOrDefault();
}
<div class="page-header">
    <div>
        <div class="eyebrow">Organiser</div>
        <h1>Welcome, @ViewData["FirstName"]</h1>
        <p>Here's how your races are looking.</p>
    </div>
    <a class="btn btn-raceday" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> New event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card rd-card stat-card h-100"><div class="card-body d-flex justify-content-between">
            <div><div class="stat-label">Total events</div><div class="stat-value">@Model.Count</div></div>
            <span class="icon-tile"><i class="bi bi-calendar-event"></i></span>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card rd-card stat-card h-100"><div class="card-body d-flex justify-content-between">
            <div><div class="stat-label">Upcoming</div><div class="stat-value">@upcoming</div></div>
            <span class="icon-tile teal"><i class="bi bi-hourglass-split"></i></span>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card rd-card stat-card h-100"><div class="card-body d-flex justify-content-between">
            <div><div class="stat-label">Total entries</div><div class="stat-value">@entries</div></div>
            <span class="icon-tile navy"><i class="bi bi-people"></i></span>
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <a asp-action="Events" class="card rd-card rd-card-hover h-100 text-reset"><div class="card-body">
            <span class="icon-tile mb-3"><i class="bi bi-list-ul"></i></span>
            <h5>My Events</h5>
            <p class="text-muted mb-0">
                @if (next != null) { <text>Next up: <strong>@next.Name</strong> on @next.EventDate.ToString("dd MMM yyyy")</text> }
                else { <text>View and edit all the races you've published.</text> }
            </p>
        </div></a>
    </div>
    <div class="col-md-6">
        <a asp-action="Create" class="card rd-card rd-card-hover h-100 text-reset"><div class="card-body">
            <span class="icon-tile navy mb-3"><i class="bi bi-plus-circle"></i></span>
            <h5>Create Event</h5>
            <p class="text-muted mb-0">Publish a new run, walk or cycle event.</p>
        </div></a>
    </div>
</div>
