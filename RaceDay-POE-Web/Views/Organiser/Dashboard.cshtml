@{
    ViewData["Title"] = "Organiser Dashboard";
}
<h2><i class="bi bi-speedometer2 text-warning"></i> Organiser Dashboard</h2>
<p class="text-muted">Welcome, @ViewData["FirstName"]. Manage your race events from here.</p>
<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100 border-warning"><div class="card-body">
            <h5 class="card-title"><i class="bi bi-calendar-event"></i> My Events</h5>
            <p class="card-text text-muted">Coming soon.</p>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card h-100 border-warning"><div class="card-body">
            <h5 class="card-title"><i class="bi bi-plus-circle"></i> Create Event</h5>
            <p class="card-text text-muted">Coming soon.</p>
        </div></div>
    </div>
</div>
