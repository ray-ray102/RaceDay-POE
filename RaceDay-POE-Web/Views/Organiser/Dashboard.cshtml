@{
    ViewData["Title"] = "Organiser Dashboard";
}
<div class="page-header">
    <div>
        <div class="eyebrow">Organiser</div>
        <h1>Welcome, @ViewData["FirstName"]</h1>
        <p>Manage your race events from here.</p>
    </div>
</div>
<div class="row g-3">
    <div class="col-md-6">
        <div class="card rd-card rd-card-hover h-100"><div class="card-body">
            <span class="icon-tile mb-3"><i class="bi bi-calendar-event"></i></span>
            <h5>My Events</h5>
            <p class="text-muted mb-0">Coming soon.</p>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card rd-card rd-card-hover h-100"><div class="card-body">
            <span class="icon-tile navy mb-3"><i class="bi bi-plus-circle"></i></span>
            <h5>Create Event</h5>
            <p class="text-muted mb-0">Coming soon.</p>
        </div></div>
    </div>
</div>
