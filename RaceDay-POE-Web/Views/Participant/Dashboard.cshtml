@{
    ViewData["Title"] = "Participant Dashboard";
}
<div class="page-header">
    <div>
        <div class="eyebrow">Participant</div>
        <h1>Welcome, @ViewData["FirstName"]</h1>
        <p>Find races and track your entries here.</p>
    </div>
</div>
<div class="row g-3">
    <div class="col-md-6">
        <div class="card rd-card rd-card-hover h-100"><div class="card-body">
            <span class="icon-tile mb-3"><i class="bi bi-search"></i></span>
            <h5>Browse Events</h5>
            <p class="text-muted mb-0">Coming soon.</p>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card rd-card rd-card-hover h-100"><div class="card-body">
            <span class="icon-tile navy mb-3"><i class="bi bi-card-checklist"></i></span>
            <h5>My Registrations</h5>
            <p class="text-muted mb-0">Coming soon.</p>
        </div></div>
    </div>
</div>
