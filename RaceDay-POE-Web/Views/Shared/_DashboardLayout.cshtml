@using RaceDay_POE_Web.Helpers
@{
    var signedInName = Context.Session.GetString(SessionKeys.FirstName) ?? "User";
    var signedInLast = Context.Session.GetString(SessionKeys.LastName) ?? "";
    var signedInRole = Context.Session.GetString(SessionKeys.Role) ?? "";
    var signedInPicture = Context.Session.GetString(SessionKeys.ProfilePictureUrl);
    var webEnv = Context.RequestServices.GetService(typeof(Microsoft.AspNetCore.Hosting.IWebHostEnvironment)) as Microsoft.AspNetCore.Hosting.IWebHostEnvironment;
    var hasLogo = webEnv != null && System.IO.File.Exists(System.IO.Path.Combine(webEnv.WebRootPath ?? "", "images", "logo.png"));
    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();
    var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
    bool IsActive(string c, string a) => controller == c.ToLowerInvariant() && action == a.ToLowerInvariant();
    bool IsActiveAny(string c, params string[] actions) => controller == c.ToLowerInvariant() && actions.Any(a => action == a.ToLowerInvariant());
    var initial = string.IsNullOrEmpty(signedInName) ? "?" : signedInName.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="~/images/favicon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay_POE_Web.styles.css" asp-append-version="true" />
</head>
<body class="dashboard-body">
    <div class="dashboard-shell">
        <aside class="dash-sidebar d-none d-lg-flex" aria-label="Dashboard navigation">
            <div class="dash-sidebar-brand">
                <a asp-controller="Home" asp-action="Index" class="dash-brand-link">
                    @if (hasLogo)
                    {
                        <img src="~/images/logo.png" alt="RaceDay" class="brand-logo" asp-append-version="true" />
                    }
                    else
                    {
                        <span class="brand-mark"><i class="bi bi-lightning-charge-fill"></i></span>
                        <span>RaceDay</span>
                    }
                </a>
            </div>

            <nav class="dash-sidebar-nav flex-grow-1">
                <div class="dash-nav-label">Menu</div>
                @if (signedInRole == RoleNames.Organiser)
                {
                    <a class="dash-nav-link @(IsActive("Organiser", "Dashboard") ? "active" : "")" asp-controller="Organiser" asp-action="Dashboard">
                        <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                    </a>
                    <a class="dash-nav-link @(IsActiveAny("Organiser", "Events", "Create", "Edit", "Delete", "Categories", "EditCategory", "Enrolments", "Results") ? "active" : "")" asp-controller="Organiser" asp-action="Events">
                        <i class="bi bi-calendar-event"></i><span>My Events</span>
                    </a>
                    <a class="dash-nav-link @(IsActive("Organiser", "Create") ? "active" : "")" asp-controller="Organiser" asp-action="Create">
                        <i class="bi bi-plus-circle"></i><span>Create Event</span>
                    </a>
                }
                else if (signedInRole == RoleNames.Participant)
                {
                    <a class="dash-nav-link @(IsActive("Participant", "Dashboard") ? "active" : "")" asp-controller="Participant" asp-action="Dashboard">
                        <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                    </a>
                    <a class="dash-nav-link @(IsActiveAny("Participant", "Events", "EventDetails") ? "active" : "")" asp-controller="Participant" asp-action="Events">
                        <i class="bi bi-search"></i><span>Browse Events</span>
                    </a>
                    <a class="dash-nav-link @(IsActive("Participant", "Enrolments") ? "active" : "")" asp-controller="Participant" asp-action="Enrolments">
                        <i class="bi bi-card-checklist"></i><span>My Enrolments</span>
                    </a>
                    <a class="dash-nav-link @(IsActive("Participant", "Results") ? "active" : "")" asp-controller="Participant" asp-action="Results">
                        <i class="bi bi-trophy"></i><span>My Results</span>
                    </a>
                    <a class="dash-nav-link @(IsActive("Participant", "Profile") ? "active" : "")" asp-controller="Participant" asp-action="Profile">
                        <i class="bi bi-person"></i><span>Profile</span>
                    </a>
                }

                <div class="dash-nav-label mt-3">Site</div>
                <a class="dash-nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i><span>Public home</span></a>
                <a class="dash-nav-link" asp-controller="Home" asp-action="About"><i class="bi bi-info-circle"></i><span>About</span></a>
                <a class="dash-nav-link" asp-controller="Home" asp-action="Contact"><i class="bi bi-envelope"></i><span>Contact</span></a>
            </nav>

            <div class="dash-sidebar-footer">
                <div class="dash-user">
                    @if (!string.IsNullOrWhiteSpace(signedInPicture))
                    {
                        <img class="dash-user-avatar" src="@signedInPicture" alt="" />
                    }
                    else
                    {
                        <span class="dash-user-avatar initials">@initial</span>
                    }
                    <div class="dash-user-meta">
                        <div class="dash-user-name">@signedInName @signedInLast</div>
                        <div class="dash-user-role">@signedInRole</div>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dash-logout-btn"><i class="bi bi-box-arrow-right"></i> Logout</button>
                </form>
            </div>
        </aside>

        <div class="offcanvas offcanvas-start dash-offcanvas" tabindex="-1" id="dashOffcanvas" aria-labelledby="dashOffcanvasLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title text-white" id="dashOffcanvasLabel">RaceDay</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body p-0 d-flex flex-column">
                <nav class="dash-sidebar-nav flex-grow-1 px-2">
                    @if (signedInRole == RoleNames.Organiser)
                    {
                        <a class="dash-nav-link @(IsActive("Organiser", "Dashboard") ? "active" : "")" asp-controller="Organiser" asp-action="Dashboard" data-bs-dismiss="offcanvas"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                        <a class="dash-nav-link" asp-controller="Organiser" asp-action="Events" data-bs-dismiss="offcanvas"><i class="bi bi-calendar-event"></i><span>My Events</span></a>
                        <a class="dash-nav-link" asp-controller="Organiser" asp-action="Create" data-bs-dismiss="offcanvas"><i class="bi bi-plus-circle"></i><span>Create Event</span></a>
                    }
                    else if (signedInRole == RoleNames.Participant)
                    {
                        <a class="dash-nav-link @(IsActive("Participant", "Dashboard") ? "active" : "")" asp-controller="Participant" asp-action="Dashboard" data-bs-dismiss="offcanvas"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                        <a class="dash-nav-link" asp-controller="Participant" asp-action="Events" data-bs-dismiss="offcanvas"><i class="bi bi-search"></i><span>Browse Events</span></a>
                        <a class="dash-nav-link" asp-controller="Participant" asp-action="Enrolments" data-bs-dismiss="offcanvas"><i class="bi bi-card-checklist"></i><span>My Enrolments</span></a>
                        <a class="dash-nav-link" asp-controller="Participant" asp-action="Results" data-bs-dismiss="offcanvas"><i class="bi bi-trophy"></i><span>My Results</span></a>
                        <a class="dash-nav-link" asp-controller="Participant" asp-action="Profile" data-bs-dismiss="offcanvas"><i class="bi bi-person"></i><span>Profile</span></a>
                    }
                </nav>
                <div class="dash-sidebar-footer">
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dash-logout-btn"><i class="bi bi-box-arrow-right"></i> Logout</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="dash-main">
            <header class="dash-topbar">
                <button class="btn dash-menu-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#dashOffcanvas" aria-controls="dashOffcanvas" aria-label="Open menu">
                    <i class="bi bi-list"></i>
                </button>
                <div class="dash-topbar-title">
                    <div class="eyebrow mb-0">@signedInRole</div>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="dash-topbar-actions ms-auto">
                    @RenderSection("TopActions", required: false)
                </div>
            </header>

            <main class="dash-content" role="main">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-1"></i> @success
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
