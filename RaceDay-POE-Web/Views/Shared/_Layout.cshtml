@using RaceDay_POE_Web.Helpers
@{
    var signedInName = Context.Session.GetString(SessionKeys.FirstName);
    var signedInRole = Context.Session.GetString(SessionKeys.Role);
    var isSignedIn = Context.Session.GetInt32(SessionKeys.UserId) != null;
    var webEnv = Context.RequestServices.GetService(typeof(Microsoft.AspNetCore.Hosting.IWebHostEnvironment)) as Microsoft.AspNetCore.Hosting.IWebHostEnvironment;
    var hasLogo = webEnv != null && System.IO.File.Exists(System.IO.Path.Combine(webEnv.WebRootPath ?? "", "images", "logo.png"));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="~/images/favicon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay_POE_Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark raceday-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand me-lg-4" asp-area="" asp-controller="Home" asp-action="Index">
                    @if (hasLogo)
                    {
                        <img src="~/images/logo.png" alt="RaceDay logo" class="brand-logo" asp-append-version="true" />
                    }
                    else
                    {
                        <span class="brand-mark"><i class="bi bi-lightning-charge-fill"></i></span>
                        <span>RaceDay</span>
                    }
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNav">
                    <ul class="navbar-nav mx-lg-auto nav-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @* Role-based menus - event pages are placeholders until their features are built *@
                        @if (isSignedIn && signedInRole == RoleNames.Organiser)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events"><i class="bi bi-calendar-event"></i> My Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Create"><i class="bi bi-plus-circle"></i> Create Event</a></li>
                        }
                        else if (isSignedIn && signedInRole == RoleNames.Participant)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Dashboard" title="Coming soon"><i class="bi bi-search"></i> Browse Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Dashboard" title="Coming soon"><i class="bi bi-card-checklist"></i> My Registrations</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>
                    <ul class="navbar-nav nav-actions align-items-lg-center">
                        @if (isSignedIn)
                        {
                            <li class="nav-item">
                                <span class="user-chip me-lg-3">
                                    <span class="avatar">@(string.IsNullOrEmpty(signedInName) ? "?" : signedInName.Substring(0, 1).ToUpper())</span>
                                    @signedInName
                                    <span class="rd-badge rd-badge-orange">@signedInRole</span>
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-raceday btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container flex-grow-1">
        <main role="main" class="py-3">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i> @success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; 2026 RaceDay &middot; Find, enter and track race events</span>
            <span class="d-flex gap-3">
                <a asp-area="" asp-controller="Home" asp-action="About">About</a>
                <a asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </span>
            <small class="photo-credits w-100">Photos from Magnific:
                <a href="https://www.magnific.com/free-photo/different-people-participating-cross-country_20283238.htm" target="_blank" rel="noopener">magnific</a>,
                <a href="https://www.magnific.com/free-photo/team-diverse-people-ready-race_2826771.htm" target="_blank" rel="noopener">rawpixel.com</a>,
                <a href="https://www.magnific.com/free-photo/cheerful-runners-having-fun-while-participating-race-nature_26346847.htm" target="_blank" rel="noopener">Drazen Zigic</a>
            </small>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
